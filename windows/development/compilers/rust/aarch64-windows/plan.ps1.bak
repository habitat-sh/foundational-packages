$pkg_name="rust"
$pkg_origin="core"
$pkg_version="1.98.0"
$pkg_description="Safe, concurrent, practical language"
$pkg_upstream_url="https://www.rust-lang.org/"
$pkg_license=@("Apache-2.0", "MIT")
$pkg_maintainer="The Habitat Maintainers <humans@habitat.sh>"
$pkg_source="https://static.rust-lang.org/dist/rust-$pkg_version-aarch64-pc-windows-msvc.msi"
$pkg_shasum = "326409579e6df53decbdfd66db5ca5b7a4be41130ce5168e176087b8280c6e47"
$pkg_deps=@("core/visual-cpp-redist-2022/14.44.35208.0/20260903174959", "core/visual-build-tools-2022/17.14.7/20260902211757", "core/windows-11-sdk/10.0.26100/20260902220215")
$pkg_build_deps=@("core/lessmsi/2.0.1/20260902215152")
$pkg_bin_dirs=@("bin")
$pkg_lib_dirs=@("lib")

function Invoke-Unpack {
    mkdir "$HAB_CACHE_SRC_PATH/$pkg_dirname"
    Push-Location "$HAB_CACHE_SRC_PATH/$pkg_dirname"
    try {
        lessmsi x (Resolve-Path "$HAB_CACHE_SRC_PATH/$pkg_filename").Path
    } finally { Pop-Location }
}

function Invoke-Install {
    Copy-Item "$HAB_CACHE_SRC_PATH/$pkg_dirname/rust-$pkg_version-aarch64-pc-windows-msvc/SourceDir/Rust/*" "$pkg_prefix" -Recurse -Force
}

function Invoke-Check() {
    (& "$HAB_CACHE_SRC_PATH/$pkg_dirname/rust-$pkg_version-aarch64-pc-windows-msvc/SourceDir/Rust/bin/rustc.exe" --version).StartsWith("rustc $pkg_version")
}
